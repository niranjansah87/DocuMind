APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8888
WEB_PORT=7777
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind-local-only
DATABASE_URL=postgresql+asyncpg://documind:documind-local-only@db:5432/documind
CORS_ORIGINS=http://localhost:7777,http://127.0.0.1:7777,https://documind.niranjansah87.com.np
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MAX_UPLOAD_BYTES=10485760
MAX_QUERY_CHARS=4000
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
MAX_OUTPUT_TOKENS=700
MAX_TOOL_STEPS=4
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=60
TICKET_CONFIRMATION_TTL_SECONDS=600
LOG_LEVEL=INFO
LOG_FORMAT=text

# Authentication & Multi-Tenancy (set AUTH_REQUIRED=true in production)
AUTH_REQUIRED=false
API_KEY=

# Rate Limiting (sliding window per-IP / per-token)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_TOOLS_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Database Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30.0

# Frontend Configuration
# Empty string lets browser use same-origin relative URLs (/api/v1/...), hiding backend port in Network tab
NEXT_PUBLIC_API_BASE_URL=
# Internal proxy target used by Next.js rewrites
INTERNAL_API_URL=http://127.0.0.1:8888
# Public canonical URL for SEO sitemaps and OpenGraph
NEXT_PUBLIC_SITE_URL=https://documind.niranjansah87.com.np
